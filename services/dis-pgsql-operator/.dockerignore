# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files.
# Source directories are re-included by name (rather than with !**/*.go) so
# Podman, the default CONTAINER_TOOL, honours them.
# See https://github.com/containers/buildah/issues/6417
**

# Re-include Go source directories copied by the Dockerfile (but not *_test.go)
!api/
!cmd/
!internal/
!test/azfakes/
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum
