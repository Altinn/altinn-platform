# Use the bundled mock fleet data. This is the default for the POC so the UI runs
# standalone without a deployed dis-console server.
VITE_USE_MOCK=true

# Base URL of a deployed dis-console `server` fleet API. Only used when
# VITE_USE_MOCK=false. Leave empty to call the same origin that serves the UI.
# Example: https://dis-console.example.internal
VITE_API_BASE_URL=

# Azure AD tenant for Azure Portal deep-links (portal.azure.com/#@<tenant>/resource/...).
# Leave empty to let the Portal resolve the tenant itself.
VITE_AZURE_PORTAL_TENANT=

# Base URL of the shared Grafana instance; enables the Logs/Metrics links on a
# syncroot's Observability tab. Example: https://grafana.example.internal
VITE_GRAFANA_BASE_URL=
