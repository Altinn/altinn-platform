{
  "name": "dis-console-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Read-only UI for the dis-console fleet API (deployment overview across environments).",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun run server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && eslint . && vitest run && vite build"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.16.0",
    "@digdir/designsystemet-react": "^1.16.0",
    "@fontsource/inter": "^5.2.5",
    "lucide-react": "^1.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
